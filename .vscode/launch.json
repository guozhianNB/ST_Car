{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "stlinkgdbtarget",
      "request": "launch",
      "name": "STM32 Launch STLink GDB Server",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "STM32: Build Debug",
      "program": "${workspaceFolder}/build/debug/ST_Car.elf",
      "deviceName": "STM32G491RET6",
      "deviceCore": "Cortex-M4",
      "gdb": "D:/Program/STM32CubeCLT_1.22.0/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
      "serverExe": "ST-LINK_gdbserver.exe",
      "serverCwd": "D:/Program/STM32CubeCLT_1.22.0/STLink-gdb-server/bin",
      "serverCubeProgPath": "D:/Program/STM32CubeCLT_1.22.0/STM32CubeProgrammer/bin",
      "serverInterface": "SWD",
      "serverPort": "61234",
      "serverReset": "Software system reset",
      "runEntry": "main",
      "imagesAndSymbols": [
        {
          "imageFileName": "${workspaceFolder}/build/debug/ST_Car.elf",
          "symbolFileName": "${workspaceFolder}/build/debug/ST_Car.elf"
        }
      ]
    }
  ]
}
